generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  nameEn              String?
  description         String?
  descriptionEn       String?
  type                ProductType
  basePriceUAH        Int?
  basePriceUSD        Int?
  inStock             Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dimensions          String?
  dimensionsEn        String?
  info                String?
  infoEn              String?
  group               ProductGroup?
  sortCatalog         Int                 @default(0)
  sortSlider          Int?
  isAddon             Boolean             @default(false)
  offerNote           String?
  offerNoteEn         String?
  packagingTemplateId String?
  status              ProductStatus       @default(DRAFT)
  packagingTemplate   PackagingTemplate?  @relation(fields: [packagingTemplateId], references: [id])
  ProductCollection   ProductCollection[]
  costProfile         ProductCostProfile?
  inventory           ProductInventory?
  materialUsages      ProductMaterial[]
  variants            ProductVariant[]
  artisanProductions  ArtisanProduction[]
  adminProductions    AdminProduction[]

  @@index([type])
  @@index([group])
  @@index([status])
  @@index([inStock])
  @@index([packagingTemplateId])
}

model ProductCostProfile {
  id               String   @id @default(cuid())
  productId        String   @unique
  laborCostUAH     Int      @default(0)
  shippingCostUAH  Int      @default(0)
  otherCostUAH     Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductInventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  finishedGoodsQty Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Material {
  id            String                    @id @default(cuid())
  name          String
  unit          String                    @default("pcs")
  stockQty      Float                     @default(0)
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  unitCostUAH   Float                     @default(0)
  category      MaterialCategory          @default(HARDWARE)
  color         String                    @default("")
  productUsages ProductMaterial[]

  @@unique([name, category, color])
  @@index([category])
  @@index([name])
}

model PackagingTemplate {
  id               String    @id @default(cuid())
  name             String    @unique
  costUAH          Int       @default(0)
  boxLabel         String?
  tissuePaperQty   Int       @default(1)
  tagCardQty       Int       @default(1)
  tagThreadQty     Int       @default(1)
  roundStickerQty  Int       @default(1)
  squareStickerQty Int       @default(1)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
}

model ProductMaterial {
  id           String   @id @default(cuid())
  productId    String
  materialId   String
  quantity     Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  variantColor String   @default("")
  material     Material @relation(fields: [materialId], references: [id])
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId, variantColor])
  @@index([productId])
  @@index([materialId])
  @@index([productId, variantColor])
}

model ProductVariant {
  id                    String                   @id @default(cuid())
  productId             String
  sku                   String?                  @unique
  liqpayGoodId          Int?
  color                 String?
  colorEn               String?
  modelSize             String?
  pouchColor            String?
  hex                   String?
  image                 String?
  inStock               Boolean                  @default(true)
  priceUAH              Int?
  priceUSD              Int?
  sortCatalog           Int?                     @default(0)
  sortBestsellers       Int?                     @default(0)
  discountUAH           Int?                     @default(0)
  shippingNote          String?
  discountPercent       Int?                     @default(0)
  showInNewArrivals     Boolean                  @default(false)
  sortNewArrivals       Int                      @default(0)
  availabilityStatus    AvailabilityStatus       @default(IN_STOCK)
  // Opt-in per variant: run the colour -> pouch -> strap configurator, where
  // straps are read from the selected pouch. Off means today's behaviour.
  pouchStrapCustomization Boolean                @default(false)
  product               Product                  @relation(fields: [productId], references: [id])
  usedAsAddonOnVariants ProductVariantAddon[]    @relation("AddonVariantOnBag")
  addonsOnVariant       ProductVariantAddon[]    @relation("BagVariantAddons")
  images                ProductVariantImage[]
  inventory             ProductVariantInventory?
  straps                ProductVariantStrap[]
  pouches               ProductVariantPouch[]
  sizes                 ProductVariantSize[]
  artisanRates          ArtisanRate[]
  artisanProductions    ArtisanProduction[]
  adminProductions      AdminProduction[]

  @@index([productId, color, modelSize, pouchColor])
  @@index([showInNewArrivals, sortNewArrivals])
}

model ProductVariantInventory {
  id               String         @id @default(cuid())
  variantId        String         @unique
  finishedGoodsQty Int            @default(0)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  url       String
  sort      Int            @default(0)
  hover     Boolean        @default(false)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, sort])
}

model ProductVariantStrap {
  id            String                     @id @default(cuid())
  variantId     String
  name          String
  liqpayGoodId  Int?
  slug          String?
  imageUrl      String?
  mainImageUrl  String?
  sort          Int                        @default(0)
  extraPriceUAH Int                        @default(0)
  variant       ProductVariant             @relation(fields: [variantId], references: [id])
  images        ProductVariantStrapImage[]

  @@index([variantId, sort])
}

model ProductVariantStrapImage {
  id      String              @id @default(cuid())
  strapId String
  url     String
  sort    Int                 @default(0)
  strap   ProductVariantStrap @relation(fields: [strapId], references: [id], onDelete: Cascade)
}

model ProductVariantPouch {
  id            String                     @id @default(cuid())
  variantId     String
  color         String
  liqpayGoodId  Int?
  imageUrl      String?
  mainImageUrl  String?
  extraPriceUAH Int                        @default(0)
  sort          Int                        @default(0)
  variant       ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  images        ProductVariantPouchImage[]
  straps        ProductVariantPouchStrap[]

  @@index([variantId, sort])
}

model ProductVariantPouchImage {
  id      String              @id @default(cuid())
  pouchId String
  url     String
  sort    Int                 @default(0)
  pouch   ProductVariantPouch @relation(fields: [pouchId], references: [id], onDelete: Cascade)
}

// Straps offered for one specific pouch, used by variants with
// pouchStrapCustomization enabled. Deliberately has neither extraPriceUAH nor
// liqpayGoodId: this customisation never changes the price, so it produces no
// fiscal component and needs no ПРРО good ID. Keeping it separate from
// ProductVariantStrap leaves the existing paid straps (and their fiscal IDs)
// untouched, and gives the pouch+strap combination photo an obvious home.
model ProductVariantPouchStrap {
  id           String                          @id @default(cuid())
  pouchId      String
  name         String
  hex          String?
  sort         Int                             @default(0)
  mainImageUrl String?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  pouch        ProductVariantPouch             @relation(fields: [pouchId], references: [id], onDelete: Cascade)
  images       ProductVariantPouchStrapImage[]

  @@index([pouchId, sort])
}

model ProductVariantPouchStrapImage {
  id           String                   @id @default(cuid())
  pouchStrapId String
  url          String
  sort         Int                      @default(0)
  pouchStrap   ProductVariantPouchStrap @relation(fields: [pouchStrapId], references: [id], onDelete: Cascade)

  @@index([pouchStrapId, sort])
}

model ProductVariantSize {
  id            String                    @id @default(cuid())
  variantId     String
  size          String
  liqpayGoodId  Int?
  imageUrl      String?
  mainImageUrl  String?
  extraPriceUAH Int                       @default(0)
  sort          Int                       @default(0)
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  images        ProductVariantSizeImage[]

  @@index([variantId, sort])
}

model ProductVariantSizeImage {
  id     String             @id @default(cuid())
  sizeId String
  url    String
  sort   Int                @default(0)
  size   ProductVariantSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
}

model ProductVariantAddon {
  id             String         @id @default(cuid())
  variantId      String
  addonVariantId String
  sort           Int            @default(0)
  addonVariant   ProductVariant @relation("AddonVariantOnBag", fields: [addonVariantId], references: [id])
  variant        ProductVariant @relation("BagVariantAddons", fields: [variantId], references: [id])

  @@unique([variantId, addonVariantId])
  @@index([variantId, sort])
  @@index([addonVariantId])
}

model Customer {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id                   String         @id @default(cuid())
  status               OrderStatus    @default(PENDING)
  createdAt            DateTime       @default(now())
  subtotalUAH          Int
  deliveryUAH          Int            @default(0)
  discountUAH          Int            @default(0)
  totalUAH             Int
  customerName         String
  customerSurname      String
  customerPatronymic   String?
  customerPhone        String
  customerEmail        String?
  shippingMethod       ShippingMethod @default(NOVA_POSHTA)
  shippingCountryCode  String?
  shippingCountryName  String?
  shippingRegion       String?
  shippingCity         String?
  shippingPostalCode   String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  npCityRef            String?
  npCityName           String?
  npWarehouseRef       String?
  npWarehouseName      String?
  paymentMethod        PaymentMethod
  paymentId            String?
  paymentStatus        String?
  paymentRaw           Json?
  inventoryAppliedAt   DateTime?
  checkoutSessionKey   String?        @unique
  // Promo code actually applied to this order, for auditing and reporting.
  promoCode            String?
  customerId           String?
  shortNumber          Int            @unique @default(autoincrement())
  grossProfitUAH       Int            @default(0)
  itemsCostUAH         Int            @default(0)
  paymentFeeUAH        Int            @default(0)
  customer             Customer?      @relation(fields: [customerId], references: [id])
  items                OrderItem[]

  @@index([status, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  strapId        String?
  sizeId         String?
  pouchId        String?
  // Set instead of strapId when the line came from the pouch+strap
  // configurator. Kept separate because it points at a different table.
  pouchStrapId   String?
  name           String
  color          String?
  modelSize      String?
  pouchColor     String?
  image          String?
  priceUAH       Int
  qty            Int
  strapName      String?
  addons         Json?
  discountUAH    Int     @default(0)
  lineRevenueUAH Int     @default(0)
  totalCostUAH   Int     @default(0)
  unitCostUAH    Int     @default(0)
  order          Order   @relation(fields: [orderId], references: [id])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String     @unique
  contactName String?
  phone       String?
  email       String?
  currency    String     @default("UAH")
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String
  status        PurchaseStatus @default(DRAFT)
  purchasedAt   DateTime
  invoiceNumber String?
  subtotalUAH   Int            @default(0)
  deliveryUAH   Int            @default(0)
  totalUAH      Int            @default(0)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([supplierId, purchasedAt])
  @@index([status, purchasedAt])
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  title        String
  qty          Float
  unit         String   @default("pcs")
  unitPriceUAH Int
  totalUAH     Int
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Expense {
  id                 String                      @id @default(cuid())
  title              String
  category           ExpenseCategory
  amountUAH          Int
  expenseDate        DateTime
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  artisanProductions ArtisanProduction[]         @relation("ArtisanProductionPaidExpense")
  adminProductions   AdminProduction[]           @relation("AdminProductionPaidExpense")
  adminSettlements   AdminProductionSettlement[] @relation("AdminProductionSettlementExpense")

  @@index([expenseDate, category])
}

model Artisan {
  id               String              @id @default(cuid())
  name             String
  phone            String?
  isActive         Boolean             @default(true)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  rates            ArtisanRate[]
  productions      ArtisanProduction[]
  adminProductions AdminProduction[]

  @@index([name])
  @@index([isActive])
}

model ArtisanRate {
  id             String              @id @default(cuid())
  artisanId      String
  variantId      String
  ratePerUnitUAH Int
  isActive       Boolean             @default(true)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  artisan        Artisan             @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productions    ArtisanProduction[]

  @@unique([artisanId, variantId])
  @@index([artisanId, isActive])
  @@index([variantId, isActive])
}

model ArtisanProduction {
  id                     String                  @id @default(cuid())
  artisanId              String
  productId              String
  variantId              String
  rateId                 String?
  qty                    Int
  ratePerUnitSnapshotUAH Int
  totalLaborUAH          Int
  settledAmountUAH       Int                     @default(0)
  producedAt             DateTime                @default(now())
  status                 ArtisanProductionStatus @default(SUBMITTED)
  notes                  String?
  approvedAt             DateTime?
  paidAt                 DateTime?
  paidExpenseId          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  artisan                Artisan                 @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant                ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  rate                   ArtisanRate?            @relation(fields: [rateId], references: [id], onDelete: SetNull)
  paidExpense            Expense?                @relation("ArtisanProductionPaidExpense", fields: [paidExpenseId], references: [id], onDelete: SetNull)

  @@index([artisanId, producedAt])
  @@index([productId, producedAt])
  @@index([variantId, producedAt])
  @@index([status, producedAt])
  @@index([rateId])
  @@index([paidExpenseId])
}

model AdminProduction {
  id               String                      @id @default(cuid())
  artisanId        String
  itemType         AdminProductionItemType     @default(CATALOG_VARIANT)
  productId        String?
  variantId        String?
  customItemName   String?
  qty              Int
  ratePerUnitUAH   Int
  totalLaborUAH    Int
  settledAmountUAH Int                         @default(0)
  producedAt       DateTime                    @default(now())
  status           ArtisanProductionStatus     @default(SUBMITTED)
  notes            String?
  paidAt           DateTime?
  paidExpenseId    String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  artisan          Artisan                     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  product          Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: SetNull)
  paidExpense      Expense?                    @relation("AdminProductionPaidExpense", fields: [paidExpenseId], references: [id], onDelete: SetNull)
  settlements      AdminProductionSettlement[]

  @@index([artisanId, producedAt])
  @@index([itemType, producedAt])
  @@index([productId, producedAt])
  @@index([variantId, producedAt])
  @@index([status, producedAt])
  @@index([paidExpenseId])
}

model AdminProductionSettlement {
  id           String          @id @default(cuid())
  productionId String
  amountUAH    Int
  settledAt    DateTime        @default(now())
  note         String?
  expenseId    String?
  createdAt    DateTime        @default(now())
  production   AdminProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  expense      Expense?        @relation("AdminProductionSettlementExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([productionId, settledAt])
  @@index([expenseId])
}

model PreorderLead {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  productId    String
  productSlug  String?
  productName  String
  variantId    String
  variantColor String?
  strapId      String?
  contactName  String?
  contact      String
  comment      String?
  items        Json?
  source       String?

  @@index([createdAt])
  @@index([productId])
  @@index([variantId])
}

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  excerpt        String
  description    String
  coverImage     String
  coverImageAlt  String
  keywords       String[]       @default([])
  publishedAt    DateTime?
  readingMinutes Int            @default(4)
  status         BlogPostStatus @default(DRAFT)
  sections       Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
}

model HomeHeroBannerSettings {
  id             Int      @id @default(1)
  desktopImage   String
  mobileImage    String
  linkHref       String   @default("/shop")
  desktopAlt     String   @default("Gerdan Hero")
  mobileAlt      String   @default("Gerdan Hero Mobile")
  slides         Json
  heroImages     Json?
  instagramPosts Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PromoCode {
  id              String    @id @default(cuid())
  // Stored uppercase; codes are compared case-insensitively.
  code            String    @unique
  discountPercent Int
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  minOrderUAH     Int       @default(0)
  // null means unlimited.
  usageLimit      Int?
  usedCount       Int       @default(0)
  // When true this is the code offered to the customer after a successful
  // order. Only one code is used for that at a time — the most recent wins.
  showAfterOrder  Boolean   @default(false)
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, endsAt])
  @@index([showAfterOrder, isActive])
}

model LiqPayCatalogMapping {
  id          String   @id @default(cuid())
  externalCode String  @unique
  liqpayGoodId Int
  itemName    String?
  priceUAH    Int?
  rawRow      Json?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([liqpayGoodId])
  @@index([syncedAt])
}

model Collection {
  id                String              @id
  slug              String              @unique
  name              String
  h1                String
  metaTitle         String?
  metaDescription   String?
  intro             String?
  faqJson           Json?
  defaultType       ProductType?
  defaultGroup      ProductGroup?
  isIndexable       Boolean             @default(true)
  sort              Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  ProductCollection ProductCollection[]

  @@index([isIndexable, sort])
}

model ProductCollection {
  id           String     @id
  productId    String
  collectionId String
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  Product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId, sort])
  @@index([productId])
}

enum ProductType {
  BAG
  BACKPACK
  CASE
  SHOPPER
  BELT_BAG
  ORNAMENTS
  ACCESSORY
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductGroup {
  BEADS
  WEAVING
}

enum AvailabilityStatus {
  IN_STOCK
  PREORDER
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  FULFILLED
}

enum PaymentMethod {
  LIQPAY
  COD
  BANK_TRANSFER
  WAYFORPAY
}

enum ShippingMethod {
  NOVA_POSHTA
  INTERNATIONAL_ADDRESS
}

enum ExpenseCategory {
  ADS
  PACKAGING
  SHIPPING
  PAYMENT_FEES
  PAYROLL
  PHOTO
  SOFTWARE
  RENT
  OTHER
}

enum MaterialCategory {
  BEADS
  THREADS
  STRAPS
  FABRIC
  HARDWARE
  CORDS
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PAID
  CANCELLED
}

enum ArtisanProductionStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum AdminProductionItemType {
  CATALOG_VARIANT
  CUSTOM_ITEM
}
